# Patch to Fix Loop Detection Interference with Streaming Tests

## File 1: src/loop_detection/detector.py

Add NoOpLoopDetector class:

```python
# Add after existing detector classes

class NoOpLoopDetector(ILoopDetector):
    """No-op loop detector for testing environments.
    
    This detector never detects loops and is used when loop detection
    is disabled via configuration.
    """
    
    def process_chunk(self, chunk: str) -> tuple[bool, str | None]:
        """Process a chunk without detecting loops.
        
        Args:
            chunk: The chunk to process
            
        Returns:
            Tuple of (False, None) indicating no loop detected
        """
        return False, None
    
    def reset(self) -> None:
        """Reset detector state (no-op)."""
        pass
```

## File 2: src/core/app/stages/infrastructure.py

Modify loop detector registration (around line 150-175):

```python
# BEFORE:
def loop_detector_factory(provider: IServiceProvider) -> HybridLoopDetector:
    return _create_hybrid_loop_detector()

services.add_transient(
    HybridLoopDetector, implementation_factory=loop_detector_factory
)
services.add_transient(
    cast(type, ILoopDetector), implementation_factory=loop_detector_factory
)

logger.debug("Registered HybridLoopDetector with DI container")

# AFTER:
# Check if loop detection is enabled in config
if config.loop_detection_enabled:
    def loop_detector_factory(provider: IServiceProvider) -> HybridLoopDetector:
        return _create_hybrid_loop_detector()

    services.add_transient(
        HybridLoopDetector, implementation_factory=loop_detector_factory
    )
    services.add_transient(
        cast(type, ILoopDetector), implementation_factory=loop_detector_factory
    )

    logger.debug("Registered HybridLoopDetector with DI container")
else:
    # Register no-op detector when loop detection is disabled
    from src.loop_detection.detector import NoOpLoopDetector
    
    def noop_detector_factory(provider: IServiceProvider) -> NoOpLoopDetector:
        return NoOpLoopDetector()
    
    services.add_transient(
        cast(type, ILoopDetector), implementation_factory=noop_detector_factory
    )
    
    logger.debug("Loop detection disabled, registered NoOpLoopDetector")
```

