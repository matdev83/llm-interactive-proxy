"""Integration tests for Responses API WebSocket transport."""

from unittest.mock import patch

import pytest
from fastapi.testclient import TestClient
from src.core.app.application_builder import build_app_async
from src.core.config.app_config import AppConfig


@pytest.fixture
async def app_with_websocket():
    """Create test app with WebSocket support enabled."""
    config = AppConfig()
    config.responses_api = {"websocket": {"frontend_enabled": True}}
    app = await build_app_async(config)
    return app


@pytest.mark.integration
@pytest.mark.asyncio
async def test_websocket_end_to_end_basic(app_with_websocket):
    """Test basic end-to-end WebSocket flow without connecting to real OpenAI."""
    # Mock the backend connector to avoid real API calls
    with patch(
        "src.connectors.openai.OpenAIConnector._handle_websocket_response"
    ) as mock_backend:
        from src.core.domain.responses import ResponseEnvelope

        # Mock backend response
        mock_backend.return_value = ResponseEnvelope(
            content={"id": "resp_123", "output": [{"type": "message", "content": "Hi"}]},
            status_code=200,
        )

        # Use TestClient for WebSocket testing
        with (
            TestClient(app_with_websocket) as client,
            client.websocket_connect("/v1/responses") as websocket,
        ):
            # Send response.create event
            request_event = {
                    "type": "response.create",
                "model": "gpt-4o",
                "input": "Hello",
            }
            websocket.send_json(request_event)

            # Receive response
            response_event = websocket.receive_json()

            # Should receive a done event
            assert response_event["type"] == "response.done"
            assert "response" in response_event


@pytest.mark.integration
@pytest.mark.asyncio
async def test_websocket_streaming_response(app_with_websocket):
    """Test streaming response over WebSocket."""
    with patch(
        "src.connectors.openai.OpenAIConnector._handle_websocket_response"
    ) as mock_backend:
        from src.core.domain.responses import StreamingResponseEnvelope
        from src.core.interfaces.response_processor_interface import ProcessedResponse

        # Mock streaming backend response
        async def mock_stream():
            yield ProcessedResponse(
                content={"type": "response.delta", "delta": {"content": "H"}},
                metadata={},
            )
            yield ProcessedResponse(
                content={"type": "response.delta", "delta": {"content": "i"}},
                metadata={},
            )
            yield ProcessedResponse(
                content={"id": "resp_123", "output": []},
                metadata={"done": True},
            )

        mock_backend.return_value = StreamingResponseEnvelope(
            content=mock_stream(), media_type="text/event-stream"
          )

          with (
              TestClient(app_with_websocket) as client,
              client.websocket_connect("/v1/responses") as websocket,
          ):
                request_event = {
                    "type": "response.create",
                    "model": "gpt-4o",
                    "input": "Hello",
                    "stream": True,
                }
                websocket.send_json(request_event)

                # Receive streaming events
                events = []
                for _ in range(3):  # Expect 3 events
                    event = websocket.receive_json()
                    events.append(event)

                # Last event should be done
                assert events[-1]["type"] == "response.done"


@pytest.mark.integration
@pytest.mark.asyncio
async def test_websocket_previous_response_id(app_with_websocket):
    """Test multi-turn conversation with previous_response_id."""
    with patch(
        "src.connectors.openai.OpenAIConnector._handle_websocket_response"
    ) as mock_backend:
        from src.core.domain.responses import ResponseEnvelope

        # First response
        response1 = ResponseEnvelope(
            content={"id": "resp_123", "output": [{"type": "message"}]},
            status_code=200,
        )

        # Second response
        response2 = ResponseEnvelope(
            content={"id": "resp_456", "output": [{"type": "message"}]},
            status_code=200,
        )

          mock_backend.side_effect = [response1, response2]

          with (
              TestClient(app_with_websocket) as client,
              client.websocket_connect("/v1/responses") as websocket,
          ):
                # First request
                request1 = {
                    "type": "response.create",
                    "model": "gpt-4o",
                    "input": "First message",
                }
                websocket.send_json(request1)
                event1 = websocket.receive_json()
                assert event1["type"] == "response.done"
                first_response_id = event1["response"]["id"]

                # Second request with previous_response_id
                request2 = {
                    "type": "response.create",
                    "model": "gpt-4o",
                    "input": "Second message",
                    "previous_response_id": first_response_id,
                }
                websocket.send_json(request2)
                event2 = websocket.receive_json()
                assert event2["type"] == "response.done"


@pytest.mark.integration
@pytest.mark.asyncio
async def test_websocket_invalid_json_error(app_with_websocket):
    """Test error handling for invalid JSON."""
    with (
        TestClient(app_with_websocket) as client,
        client.websocket_connect("/v1/responses") as websocket,
    ):
        # Send invalid JSON
        websocket.send_text("not valid json")

        # Should receive error
        error_event = websocket.receive_json()
        assert error_event["type"] == "error"
        assert error_event["error"]["code"] == "invalid_json"


@pytest.mark.integration
@pytest.mark.asyncio
async def test_websocket_unsupported_event_error(app_with_websocket):
    """Test error handling for unsupported event type."""
    with (
        TestClient(app_with_websocket) as client,
        client.websocket_connect("/v1/responses") as websocket,
    ):
        # Send unsupported event
        unsupported_event = {"type": "unsupported.event"}
        websocket.send_json(unsupported_event)

        # Should receive error
        error_event = websocket.receive_json()
        assert error_event["type"] == "error"
        assert error_event["error"]["code"] == "unsupported_event_type"


@pytest.mark.integration
@pytest.mark.asyncio
    async def test_websocket_previous_response_not_found_error(app_with_websocket):
      """Test error handling for previous_response_not_found."""
      with (
          TestClient(app_with_websocket) as client,
          client.websocket_connect("/v1/responses") as websocket,
      ):
            # Send request with non-existent previous_response_id
            request = {
                "type": "response.create",
                "model": "gpt-4o",
                "input": "Test",
                "previous_response_id": "resp_nonexistent",
            }
            websocket.send_json(request)

            # Should receive error
            error_event = websocket.receive_json()
            assert error_event["type"] == "error"
            assert error_event["error"]["code"] == "previous_response_not_found"


@pytest.mark.integration
@pytest.mark.asyncio
@pytest.mark.skip(reason="Requires real OpenAI API key")
async def test_websocket_real_openai_connection():
    """Test real WebSocket connection to OpenAI (requires API key).

    This test is skipped by default. To run it:
    1. Set OPENAI_API_KEY environment variable
    2. Run: pytest -m integration --runxfail tests/integration/test_responses_api_websocket.py::test_websocket_real_openai_connection
    """
    import os

    api_key = os.getenv("OPENAI_API_KEY")
    if not api_key:
        pytest.skip("OPENAI_API_KEY not set")

    from src.connectors.openai_websocket_client import OpenAIWebSocketClient

    client = OpenAIWebSocketClient(api_key=api_key)

    try:
        await client.connect()

        payload = {
            "model": "gpt-4o-mini",
            "input": "Say 'Hello, World!' and nothing else.",
            "max_output_tokens": 20,
        }

        responses = []
        async for response in client.send_response_create(payload):
            responses.append(response)
            if response.metadata.get("done"):
                break

        assert len(responses) > 0
        # Last response should be done
        assert responses[-1].metadata.get("done") is True

    finally:
        await client.disconnect()
